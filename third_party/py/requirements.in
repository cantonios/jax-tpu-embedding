# Library.
absl-py
flax @ https://github.com/google/flax/archive/e2134af.zip
numpy
dm-tree
# Pre-release of JAX required for SparseCore TPUs.
jax[tpu];sys_platform == 'linux' and platform_machine == 'x86_64' --pre
jax[cpu];sys_platform != 'linux' or platform_machine != 'x86_64'

# Build utilities.
auditwheel
build
setuptools
wheel

# Testing.
clu
einops
google-benchmark
optax
orbax
protobuf

# Paths for pre-releases of JAX and libtpu.
--extra-index-url https://us-python.pkg.dev/ml-oss-artifacts-published/jax-public-nightly-artifacts-registry/simple/
-f https://storage.googleapis.com/jax-releases/libtpu_releases.html
